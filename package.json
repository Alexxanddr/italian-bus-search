{
  "name": "italian-travel-search",
  "version": "0.3.4",
  "mcpName": "io.github.Alexxanddr/italian-travel-search",
  "description": "Read-only Italian bus and train search with live prices, NeTEx fallback and MCP tools",
  "keywords": [
    "italian",
    "bus",
    "rail",
    "netex",
    "travel",
    "coach",
    "mcp",
    "model-context-protocol"
  ],
  "author": {
    "name": "Alessandro Sottile",
    "url": "https://github.com/Alexxanddr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexxanddr/italian-travel-search.git"
  },
  "bugs": {
    "url": "https://github.com/Alexxanddr/italian-travel-search/issues"
  },
  "homepage": "https://github.com/Alexxanddr/italian-travel-search#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "italian-travel-search": "dist/mcp/stdio.js",
    "italian-travel-search-mcp": "dist/mcp/stdio.js"
  },
  "files": [
    "dist",
    "docs",
    "!docs/private/**",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "server.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "mcp": "node --experimental-strip-types src/mcp/stdio.ts",
    "mcp:built": "node dist/mcp/stdio.js",
    "rail:update": "node dist/rail/update.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "check": "npm run test && npm run type-check && npm run lint && npm run build",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "saxes": "^6.0.0",
    "zod": "^4.6.7"
  }
}
